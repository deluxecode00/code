NODE_ENV=production
PORT=5174

# Acceso al panel /admin. Cambia ambos valores por secretos largos y únicos.
ADMIN_PASSWORD=cambia-esta-clave
SESSION_SECRET=cambia-este-secreto-de-sesion

# Usa preferentemente la Internal Database URL de Render Postgres si la base y
# el backend están en la misma cuenta y región.
RULES_DATABASE_URL=postgresql://usuario:clave@host/base

# Opcional. El código lo detecta automáticamente:
# false para la URL interna de Render; true para una URL externa con TLS.
RULES_DATABASE_SSL=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://tu-backend.onrender.com/auth/google/callback
GMAIL_TOKENS=
